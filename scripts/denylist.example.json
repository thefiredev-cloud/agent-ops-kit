{
  "_comment": "Example deny list. Copy it, put your own values in, and keep your copy out of version control. The scrubber holds no patterns of its own, so your private list never has to ship with the tool.",
  "_groups": {
    "secret": "credentials. Fatal in any build.",
    "identity": "personal or company data. Fine internally, fatal in a public build."
  },
  "patterns": [
    {
      "name": "my-email",
      "group": "identity",
      "flags": "i",
      "regex": "\\b[a-z0-9._%+-]+@acme\\.example\\b",
      "hint": "use contact@acme.example"
    },
    {
      "name": "my-name",
      "group": "identity",
      "flags": "i",
      "regex": "\\b(?:Ada Lovelace|Lovelace)\\b",
      "hint": "use a placeholder name"
    },
    {
      "name": "my-phone",
      "group": "identity",
      "regex": "\\+?1?[-. (]*555[-. )]*01\\d{2}\\b",
      "hint": "use 555-0100"
    },
    {
      "name": "private-network-range",
      "group": "identity",
      "regex": "\\b10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}\\b",
      "hint": "use a documentation address such as 192.0.2.1"
    },
    {
      "name": "my-hostnames",
      "group": "identity",
      "flags": "i",
      "regex": "\\b(?:build-box|laptop-01)\\b",
      "hint": "use host-a / host-b"
    },
    {
      "name": "home-paths",
      "group": "identity",
      "regex": "/(?:home|Users)/(?:ada|deploy)(?![A-Za-z0-9_-])",
      "hint": "use /home/user or $HOME"
    },
    {
      "name": "company-names",
      "group": "identity",
      "regex": "\\b(?:AcmeInternal|OldProductName)\\b",
      "hint": "use ExampleCo"
    },
    {
      "name": "openai-style-key",
      "group": "secret",
      "regex": "\\bsk-[A-Za-z0-9_-]{16,}\\b",
      "hint": "revoke this key, then remove it"
    },
    {
      "name": "stripe-key",
      "group": "secret",
      "regex": "\\bsk_(?:live|test)_[A-Za-z0-9]{16,}\\b",
      "hint": "revoke this key, then remove it"
    },
    {
      "name": "github-token",
      "group": "secret",
      "regex": "\\b(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})\\b",
      "hint": "revoke this token, then remove it"
    },
    {
      "name": "slack-token",
      "group": "secret",
      "regex": "\\bxox[baprse]-[A-Za-z0-9-]{10,}\\b",
      "hint": "revoke this token, then remove it"
    },
    {
      "name": "private-key-block",
      "group": "secret",
      "regex": "-----BEGIN(?:[A-Z ]+)? PRIVATE KEY-----",
      "hint": "rotate the key pair, then remove the block"
    },
    {
      "name": "env-assignment",
      "group": "secret",
      "regex": "\\b(?:API_KEY|SECRET_KEY|ACCESS_TOKEN|AUTH_TOKEN|PASSWORD|PRIVATE_KEY|CLIENT_SECRET|DATABASE_URL|SERVICE_ROLE_KEY)\\s*=\\s*[\"']?[A-Za-z0-9_.:/-]{12,}",
      "hint": "use a placeholder like <your-key>"
    }
  ]
}
